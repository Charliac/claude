    },
    {
      "type": "range",
      "id": "accent_text_margin_left",
      "min": -10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Accent Text Left Margin",
      "default": 0
    },
    {
      "type": "color_background",
